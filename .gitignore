# Release artifacts produced by scripts/release.ts
/build/

# Ad-hoc package.sh output (Homebrew formula / GitHub Release zip)
/dist/
/.derived/

# LLVM / xcodebuild test coverage dumps (cwd)
*.profraw
*.profdata
*.xcresult

# Local Xcode derived data if someone builds from the repo root
DerivedData/

# Bun / node deps
node_modules/

# Rust build output for the Alacritty backend's bridge. Cargo.lock IS tracked:
# the Xcode build phase passes --locked so a build is reproducible.
/Vendor/alacritty-bridge/target/

# macOS
.DS_Store

