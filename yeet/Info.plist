<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- This Info.plist is authored by hand (GENERATE_INFOPLIST_FILE = NO) so we
	     own the Bundle* keys instead of letting the generator derive them.
	     PRODUCT_NAME is yeet (the Swift module). EXECUTABLE_NAME is yeet,
	     the CLI users run. KERO_DISPLAY_NAME supplies Yeet for Release and
	     Yeet Debug for Debug. The release bundle id is sh.yeet (Debug
	     sh.yeet.dev) so this app can sit beside official Kero (sh.kero)
	     without sharing Launch Services identity or UserDefaults. Dynamic
	     values use build-setting substitution to stay in sync. -->

	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<!-- User-visible name. CFBundleName drives the app menu (bold menu next to
	     the Apple menu); CFBundleDisplayName is what Finder/Dock show. -->
	<key>CFBundleName</key>
	<string>$(KERO_DISPLAY_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>$(KERO_DISPLAY_NAME)</string>

	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Yeet contributors. Based on Kero. GPLv3.</string>

	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>

	<!-- Finder exposes this app service in a folder's context menu. AppKit
	     forwards the selected paths to KeroApplicationDelegate.openInKero. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>New $(KERO_DISPLAY_NAME) Project Here</string>
			</dict>
			<key>NSMessage</key>
			<string>openInKero</string>
			<key>NSRequiredContext</key>
			<dict>
				<key>NSTextContent</key>
				<string>FilePath</string>
			</dict>
			<key>NSSendTypes</key>
			<array>
				<string>NSFilenamesPboardType</string>
				<string>public.plain-text</string>
			</array>
		</dict>
	</array>

	<!-- Programs running inside the terminal (e.g. Claude Code voice dictation)
	     request mic access attributed to Yeet as the responsible process. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>A program running within Yeet would like to use your microphone.</string>
</dict>
</plist>
