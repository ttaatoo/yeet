    "`yeet +themes` needs an interactive terminal. Use `yeet +themes --list` to print theme names." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`yeet +themes`には対話型ターミナルが必要です。テーマ名を表示するには`yeet +themes --list`を使ってください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`yeet +themes` 需要交互式终端。请使用 `yeet +themes --list` 列出主题名称。"
          }
        }
      }
    },
